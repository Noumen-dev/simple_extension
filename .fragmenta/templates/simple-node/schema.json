{
  "type": "{{NodeName}}",
  "kind": "class",
  "metadata": {
    "displayName": "{{displayName}}",
    "icon": "Box"
  },
  "ports": {
    "inputs": [
      {
        "type": "signal",
        "key": "execute",
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      },
      {
        "type": "data",
        "key": "text",
        "displayName": "text",
        "dataType": "string",
        "required": true,
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      }
    ],
    "outputs": [
      {
        "type": "signal",
        "key": "next",
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      },
      {
        "type": "data",
        "key": "result",
        "displayName": "result",
        "dataType": "string",
        "data": {
          "isNode": true
        },
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      }
    ]
  },
  "ui": {
    "type": "default"
  },
  "data": {
    "type": "{{NodeName}}",
    "language": "python",
    "package": "caia_core",
    "version": "1.0.0",
    "deprecated": false,
    "description": "{{description}}",
    "tags": [
      "{{tag}}"
    ],
    "category": "{{category}}"
  },
  "code": {
    "path": "{{node_name}}.py"
  }
}
