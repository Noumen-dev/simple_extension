        "type": "signal",
        "key": "execute",
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      },
      {
        "type": "data",
        "key": "file",
        "displayName": "file",
        "dataType": "file",
        "description": "Excel-файл или ZIP-пакет IMAP; для ZIP задайте attachment",
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      },
      {
        "type": "data",
        "key": "attachment",
        "displayName": "attachment",
        "dataType": "object",
