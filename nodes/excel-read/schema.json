        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      },
      {
        "type": "data",
        "key": "memory_limit_enforced",
        "displayName": "memory_limit_enforced",
        "dataType": "boolean",
        "description": "Применён системный лимит адресного пространства процесса",
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      }
    ]
  },
  "ui": {
    "type": "default"
  },
  "parameters": {
    "max_file_bytes": {
      "displayName": "Max file bytes",
      "description": "Максимальный размер исходного Excel-файла",
      "defaultValue": 40000000,
      "control": {
        "kind": "number"
      }
    },
    "max_cells": {
      "displayName": "Max cells",
      "description": "Максимум ячеек; для XLS также предел площади листов",
      "defaultValue": 1000000,
      "control": {
        "kind": "number"
      }
    },
    "max_uncompressed_bytes": {
      "displayName": "Max expanded bytes",
      "description": "Предел суммарного распакованного размера OOXML",
      "defaultValue": 64000000,
      "control": {
        "kind": "number"
      }
    },
    "max_result_bytes": {
      "displayName": "Max result bytes",
      "description": "Максимальный размер полной выгрузки JSONL",
      "defaultValue": 100000000,
      "control": {
        "kind": "number"
      }
    },
    "max_memory_bytes": {
      "displayName": "Max memory bytes",
      "description": "Предел адресного пространства Unix-runner; на Windows действуют лимиты файлов и ячеек",
      "defaultValue": 512000000,
      "control": {
        "kind": "number"
      }
    },
    "preview_cells": {
      "displayName": "Preview cells",
      "description": "Максимум ячеек в JSON-просмотре; также действует предел 64 КиБ",
      "defaultValue": 20,
      "control": {
        "kind": "number"
      }
    }
  },
