      },
      {
        "type": "data",
        "key": "errors",
        "displayName": "errors",
        "dataType": "array",
        "description": "Ошибки чтения",
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      },
      {
        "type": "data",
        "key": "schema_version",
        "displayName": "schema_version",
        "dataType": "string",
