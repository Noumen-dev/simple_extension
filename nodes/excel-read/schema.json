          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        }
      },
      {
        "type": "data",
        "key": "cells",
        "displayName": "cells",
        "dataType": "array",
        "description": "Ограниченный просмотр ячеек; полные данные в cells_file",
