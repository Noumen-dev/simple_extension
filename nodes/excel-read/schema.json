        "displayName": "archive_entry",
        "dataType": "string",
        "description": "Необязательный путь вложения внутри ZIP-пакета",
        "connectionRules": {
          "requireSameType": true,
          "requireSameDataType": false,
          "allowMultipleOutputs": true,
          "allowMultipleInputs": true
        },
        "defaultValue": ""
      }
